# ---------------------------------------------------------------------------
# SENSITIVE / PERSONAL DATA — never commit. (browser_data holds the live
# Amazon Music login session/cookies; output/backups hold your library.)
# ---------------------------------------------------------------------------
browser_data/
output/
backups/
input/
screenshots/

# Logs (may contain playlist URLs, ASINs, personal data)
*.log

# Claude Code tooling config (local permissions, locks — not part of the app)
.claude/

# Smoke-test data dumps (large, regenerated by the smoke_*.py scripts)
smoke_*_dump.json

# Database backups created by File -> Export Database (hold personal library data)
amm_backup_*.zip

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Build / installer artifacts
# ---------------------------------------------------------------------------
build/
dist/
installer_output/
*.manifest

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
